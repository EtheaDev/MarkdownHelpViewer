<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{1A320BED-5C67-48CC-AB97-436070E394AB}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="MarkdownProcessor.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="dclMarkdownProcessor.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="MarkdownProcessor">
        <MSBuild Projects="MarkdownProcessor.dproj"/>
    </Target>
    <Target Name="MarkdownProcessor:Clean">
        <MSBuild Projects="MarkdownProcessor.dproj" Targets="Clean"/>
    </Target>
    <Target Name="MarkdownProcessor:Make">
        <MSBuild Projects="MarkdownProcessor.dproj" Targets="Make"/>
    </Target>
    <Target Name="dclMarkdownProcessor">
        <MSBuild Projects="dclMarkdownProcessor.dproj"/>
    </Target>
    <Target Name="dclMarkdownProcessor:Clean">
        <MSBuild Projects="dclMarkdownProcessor.dproj" Targets="Clean"/>
    </Target>
    <Target Name="dclMarkdownProcessor:Make">
        <MSBuild Projects="dclMarkdownProcessor.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="MarkdownProcessor;dclMarkdownProcessor"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="MarkdownProcessor:Clean;dclMarkdownProcessor:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="MarkdownProcessor:Make;dclMarkdownProcessor:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
    <ItemGroup Condition="'$(BuildGroup)'=='ALL_Win64'">
        <BuildGroupProject Include="MarkdownProcessor.dproj">
            <ProjectGuid>{EB280847-BC04-4371-B384-6A0D3047B7F2}</ProjectGuid>
            <Configurations>Release</Configurations>
            <Platforms>Win64</Platforms>
            <Enabled>True</Enabled>
        </BuildGroupProject>
        <BuildGroupProject Include="dclMarkdownProcessor.dproj">
            <ProjectGuid>{B64C022A-4F55-4209-AA33-D4569A2D7B28}</ProjectGuid>
            <Configurations>Release</Configurations>
            <Platforms>Win64</Platforms>
            <Enabled>True</Enabled>
        </BuildGroupProject>
    </ItemGroup>
    <ItemGroup Condition="'$(BuildGroup)'=='ALL_Win32'">
        <BuildGroupProject Include="MarkdownProcessor.dproj">
            <ProjectGuid>{EB280847-BC04-4371-B384-6A0D3047B7F2}</ProjectGuid>
            <Configurations>Release</Configurations>
            <Platforms>Win32</Platforms>
            <Enabled>True</Enabled>
        </BuildGroupProject>
        <BuildGroupProject Include="dclMarkdownProcessor.dproj">
            <ProjectGuid>{B64C022A-4F55-4209-AA33-D4569A2D7B28}</ProjectGuid>
            <Configurations>Release</Configurations>
            <Platforms>Win32</Platforms>
            <Enabled>True</Enabled>
        </BuildGroupProject>
    </ItemGroup>
</Project>
