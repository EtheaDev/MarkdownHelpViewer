            <Dependencies/>
        </Projects>
        <Projects Include="MarkDownViewer.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="dclMarkDownViewer.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="MarkdownProcessor">
        <MSBuild Projects="..\..\Ext\MarkdownProcessor\Packages\D12\MarkdownProcessor.dproj"/>
    </Target>
    <Target Name="MarkdownProcessor:Clean">
        <MSBuild Projects="..\..\Ext\MarkdownProcessor\Packages\D12\MarkdownProcessor.dproj" Targets="Clean"/>
    </Target>
    <Target Name="MarkdownProcessor:Make">
        <MSBuild Projects="..\..\Ext\MarkdownProcessor\Packages\D12\MarkdownProcessor.dproj" Targets="Make"/>
